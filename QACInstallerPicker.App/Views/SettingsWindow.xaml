<Window x:Class="QACInstallerPicker.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="580" Width="760" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="対応表(Excel)" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExcelPath}" Margin="0,0,8,8" />
        <Button Grid.Row="0" Grid.Column="2" Content="参照" Margin="0,0,0,8" Command="{Binding BrowseExcelCommand}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="UNCルート" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding UncRoot}" Margin="0,0,8,8" />
        <Button Grid.Row="1" Grid.Column="2" Content="参照" Margin="0,0,0,8" Command="{Binding BrowseUncRootCommand}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="出力ベース" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutputBaseFolder}" Margin="0,0,8,8" />
        <Button Grid.Row="2" Grid.Column="2" Content="参照" Margin="0,0,0,8" Command="{Binding BrowseOutputBaseCommand}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="送付履歴Excel" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShipmentHistoryExcelPath}" Margin="0,0,8,8" />
        <Button Grid.Row="3" Grid.Column="2" Content="参照" Margin="0,0,0,8" Command="{Binding BrowseShipmentHistoryExcelCommand}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="同時実行数" Margin="0,0,8,8" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxConcurrentTransfers}" Width="80" Margin="0,0,0,8" />

        <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Header="設定Excel出力" Margin="0,4,0,0">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                    <CheckBox Content="基本情報" IsChecked="{Binding IncludeBasicInfoInBulkExcel}" Margin="0,0,16,0" />
                    <CheckBox Content="インストーラ選択" IsChecked="{Binding IncludeModuleSelectionInBulkExcel}" Margin="0,0,16,0" />
                    <CheckBox Content="カスタム選択" IsChecked="{Binding IncludeCustomTabsInBulkExcel}" Margin="0,0,16,0" />
                    <CheckBox Content="カスタム圧縮設定" IsChecked="{Binding IncludeCustomZipPlansInBulkExcel}" />
                </WrapPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="対象Helix" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="280"
                              ItemsSource="{Binding BulkExcelHelixVersionOptions}"
                              SelectedItem="{Binding SelectedBulkExcelHelixVersion}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Text="対象カスタムタブ（チェックしたタブだけExcelに出力）" Margin="0,0,0,4" />
                <Border Grid.Row="3" BorderBrush="#CCC" BorderThickness="1" Padding="6">
                    <ItemsControl ItemsSource="{Binding BulkExcelCustomTabOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="初期化" Width="90" Margin="0,8,8,0" Command="{Binding ResetCommand}" />
            <Button Content="保存" Width="90" Margin="0,8,8,0" Command="{Binding SaveCommand}" />
            <Button Content="キャンセル" Width="90" Margin="0,8,0,0" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</Window>
