                                                </StackPanel>
                                                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ShipmentHistorySelectedOsMultiFilterOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Value}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="インストーラ名" />
                                    <ToggleButton x:Name="ShipmentHistoryInstallerFilterToggle"
                                                  Width="140"
                                                  Content="{Binding ShipmentHistoryInstallerFilterDisplay}"
                                                  IsChecked="{Binding IsShipmentHistoryInstallerFilterPopupOpen, Mode=TwoWay}" />
                                    <Popup PlacementTarget="{Binding ElementName=ShipmentHistoryInstallerFilterToggle}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           IsOpen="{Binding IsShipmentHistoryInstallerFilterPopupOpen, Mode=TwoWay}"
                                           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <Border BorderBrush="#999" BorderThickness="1" Background="White" Padding="6">
                                            <StackPanel MinWidth="280">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Button Content="全選択" Width="72" Margin="0,0,6,0"
                                                            Command="{Binding SetShipmentHistoryMultiFilterSelectionCommand}"
                                                            CommandParameter="Installer|All" />
                                                    <Button Content="全解除" Width="72"
                                                            Command="{Binding SetShipmentHistoryMultiFilterSelectionCommand}"
                                                            CommandParameter="Installer|None" />
                                                </StackPanel>
                                                <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding ShipmentHistoryInstallerMultiFilterOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Value}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ShipmentHistoryViewItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ColumnWidth="SizeToCells"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="NoWrap" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="送付日"
                                                Binding="{Binding ShipmentDate, StringFormat=yyyy/MM/dd}"
                                                Width="SizeToCells" />
                            <DataGridTextColumn Header="会社名" Binding="{Binding CompanyName}" Width="SizeToCells" />
                            <DataGridTextColumn Header="個人名" Binding="{Binding PersonName}" Width="SizeToCells" />
                            <DataGridTextColumn Header="区分" Binding="{Binding Category}" Width="SizeToCells" />
                            <DataGridTextColumn Header="Helixバージョン" Binding="{Binding HelixVersion}" Width="SizeToCells" />
                            <DataGridTextColumn Header="コード" Binding="{Binding Code}" Width="SizeToCells" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="SizeToCells" />
                            <DataGridTextColumn Header="対応表版数" Binding="{Binding CompatibilityVersion}" Width="SizeToCells" />
                            <DataGridTextColumn Header="選択OS" Binding="{Binding SelectedOs}" Width="SizeToCells" />
                            <DataGridTextColumn Header="インストーラ名" Binding="{Binding InstallerName}" Width="SizeToCells" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

