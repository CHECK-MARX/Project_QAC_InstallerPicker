                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="実行日時" Binding="{Binding Timestamp}" Width="160" />
                            <DataGridTextColumn Header="会社名" Binding="{Binding Company}" Width="140" />
