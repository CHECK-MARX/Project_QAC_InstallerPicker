                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Helixバージョン" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ShipmentHelixVersion}" IsReadOnly="True" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="コード" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ShipmentCode}" IsReadOnly="True" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="名称" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ShipmentName}" IsReadOnly="True" Margin="0,0,0,8" />

